{
  "name": "sholatku-reminder-root",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "author": "adwerygaming",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=21"
  },
  "workspaces": [
    "packages/core",
    "packages/frontend",
    "packages/backend",
    "packages/providers/discord",
    "packages/providers/whatsapp",
    "packages/shared"
  ],
  "scripts": {
    "start-core": "npm run start --workspace=packages/core",
    "start-frontend": "npm run start --workspace=packages/frontend",
    "start-backend": "npm run start --workspace=packages/backend",
    "start-discord": "npm run start --workspace=packages/providers/discord",

    "dev-core": "npm run dev --workspace=packages/core",
    "dev-frontend": "npm run dev --workspace=packages/frontend",
    "dev-backend": "npm run start:dev --workspace=packages/backend",
    "dev-discord": "npm run dev --workspace=packages/providers/discord",

    "build-core": "npm run build --workspace=packages/core",
    "build-shared": "npm run build --workspace=packages/shared",
    "build-frontend": "npm run build --workspace=packages/frontend",
    "build-backend": "npm run build --workspace=packages/backend",
    "build-discord": "npm run build --workspace=packages/providers/discord",

    "dev-c": "npm run dev-core",
    "dev-f": "npm run dev-frontend",
    "dev-b": "npm run dev-backend",
    "dev-d": "npm run dev-discord",

    "build-c": "npm run build-core",
    "build-s": "npm run build-shared",
    "build-f": "npm run build-frontend",
    "build-b": "npm run build-backend",
    "build-d": "npm run build-discord",
    
    "seed": "npx tsx scripts/seed.ts",

    "lint-core": "npx eslint packages/core",
    "lint-frontend": "npx eslint packages/frontend",
    "lint-backend": "npx eslint packages/backend",
    "lint-shared": "npx eslint packages/shared",
    "lint-discord": "npx eslint packages/providers/discord",
    "lint-whatsapp": "npx eslint packages/providers/whatsapp"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/node": "^25.3.1",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin-ts": "^4.4.1"
  }
}
