{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "resolvePackageJsonExports": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "./dist",
    "incremental": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "sholatku-reminder-core": [
        "../core/src/index.ts"
      ],
      "sholatku-reminder-core/src/*": [
        "../core/src/*"
      ],
      "sholatku-reminder-shared/*": [
        "../shared/*"
      ]
    }
  },
  "exclude": [
    "test",
    "dist",
    "node_modules"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../shared"
    }
  ]
}
