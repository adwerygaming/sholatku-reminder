{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2023",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "composite": true
  },
  "include": [
    ".",
  ],
  "exclude": [
    "coverage",
    "dist",
    "docs",
    "node_modules"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}