{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2023",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "sholatku-reminder-core": [
        "../core/src/index.ts"
      ],
      "sholatku-reminder-core/src/*": [
        "../core/src/*"
      ],
      "sholatku-reminder-shared/*": [
        "../shared/*"
      ]
    }
  },
  "include": [
    "src",
    "src/utils",
    "src/types"
  ],
  "exclude": [
    "coverage",
    "dist",
    "docs",
    "node_modules"
  ],
  "references": [
    {
      "path": "../../core"
    },
    {
      "path": "../../shared"
    }
  ]
}